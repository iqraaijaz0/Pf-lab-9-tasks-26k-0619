#include <stdio.h>
float fixPrice(float p) {
    if (p < 0) {
        return 0;
    }
    return p;
}
int fixQty(int q) {
    if (q < 0) {
        return 0;
    }
    return q;
}
float itemTotal(float price, int qty) {
    return price * qty;
}
float calcTotal(float t1, float t2) {
    return t1 + t2;
}
float calcDiscount(float total) {
    if (total > 1000) {
        return total * 0.10;
    }
    return 0;
}
float calcPayable(float total, float discount) {
    return total - discount;
}
float higherPrice(float p1, float p2) {
    if (p1 > p2) {
        return p1;
    }
    return p2;
}
int isEqual(float p1, float p2) {
    if (p1 == p2) {
        return 1;
    }
    return 0;
}
int main() {
    float p1, p2, t1, t2, total, discount, payable, high;
    int q1, q2;
    printf("Enter price of item 1: ");
    scanf("%f", &p1);
    printf("Enter quantity of item 1: ");
    scanf("%d", &q1);
    printf("Enter price of item 2: ");
    scanf("%f", &p2);
    printf("Enter quantity of item 2: ");
    scanf("%d", &q2);
    p1 = fixPrice(p1);
    p2 = fixPrice(p2);
    q1 = fixQty(q1);
    q2 = fixQty(q2);
    t1 = itemTotal(p1, q1);
    t2 = itemTotal(p2, q2);
    total = calcTotal(t1, t2);
    discount = calcDiscount(total);
    payable = calcPayable(total, discount);
    high = higherPrice(p1, p2);
    printf("\n---- RECEIPT ----\n");
    printf("Item 1: %.2f x %d = %.2f\n", p1, q1, t1);
    printf("Item 2: %.2f x %d = %.2f\n", p2, q2, t2);
    printf("Total: %.2f\n", total);
    printf("Discount: %.2f\n", discount);
    printf("Payable: %.2f\n", payable);
    if (isEqual(p1, p2)) {
        printf("Both items have equal price: %.2f\n", p1);
    } else {
        printf("Higher unit price: %.2f\n", high);
    }
    return 0;
}
